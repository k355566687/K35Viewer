<UserControl x:Class="K35Viewer.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- サムネイル表示の1枚。画像は行が画面に出たときに初めて読み込まれる -->
        <DataTemplate x:Key="ThumbnailCell">
            <StackPanel Width="164"
                        Margin="6"
                        ToolTip="{Binding FileName}"
                        AutomationProperties.Name="{Binding FileName}"
                        AutomationProperties.ItemStatus="{Binding StatusText}"
                        MouseLeftButtonDown="OnThumbnailCellMouseLeftButtonDown"
                        MouseRightButtonDown="OnArchiveItemMouseRightButtonDown">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="開く" Click="OnOpenMenuClick" />
                        <MenuItem Header="名前を変更 (F2)" Click="OnRenameMenuClick" />
                        <MenuItem Header="別のフォルダへ移動…" Click="OnMoveMenuClick" />
                        <MenuItem Header="削除 (Delete)" Click="OnDeleteMenuClick" />
                        <Separator />
                        <MenuItem Header="エクスプローラーで表示" Click="OnShowInExplorerMenuClick" />
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource K35.SelectionFillBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="164"
                        Height="220"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <TextBlock Text="{Binding PlaceholderText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Image Source="{Binding Thumbnail}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding FileName}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="画像" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding ImageCountText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,0" />
                    <!-- 選択を、色だけでなく文字でも示す -->
                    <TextBlock Text="✓ 選択中" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!--
            サムネイル表示の1行分。選択やフォーカスの枠は付けない。
            エクスプローラーと同じく、カードの大きさは変えずに、余った幅をカードの間へ均等に分ける
            （1行の枚数ぶんの等しい幅の枠に、カードを中央に置く。最後の行も同じ枠に並ぶため、列がそろう）。
            もう1枚入る幅になると、1行の枚数が増える（LibraryViewModel.ColumnCount）。
        -->
        <DataTemplate x:Key="ThumbnailRowTemplate">
            <ItemsControl ItemsSource="{Binding Items}"
                          ItemTemplate="{StaticResource ThumbnailCell}"
                          Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"
                                     Columns="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- 詳細表示の文字の列。列の幅に収まらない部分は「…」で省略し、全体はツールチップで示す -->
        <DataTemplate x:Key="FileNameCell">
            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
        </DataTemplate>
        <DataTemplate x:Key="LocationCell">
            <TextBlock Text="{Binding LocationText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左ナビゲーション: フォルダツリーとフォルダ追加 -->
        <DockPanel Grid.Column="0" Margin="12">
            <Button DockPanel.Dock="Bottom"
                    Content="管理対象から外す"
                    Command="{Binding RemoveSelectedFolderCommand}"
                    Padding="14,6"
                    Margin="0,8,0,0"
                    ToolTip="選択中の管理フォルダ（ツリーの最上位のフォルダ）を、管理対象から外します。ファイルは削除されません"
                    AutomationProperties.Name="選択中の管理フォルダを管理対象から外す" />
            <Button DockPanel.Dock="Bottom"
                    Content="＋ フォルダを追加"
                    Command="{Binding AddFolderCommand}"
                    Padding="14,6"
                    Margin="0,8,0,0"
                    AutomationProperties.Name="管理フォルダを追加" />
            <TextBlock DockPanel.Dock="Top"
                       Text="ライブラリ"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <!-- 長い名前は右端で切れるにまかせ、横スクロールは出さない（ツールチップでフルパスを示す） -->
            <TreeView x:Name="FolderTree"
                      ItemsSource="{Binding FolderRoots}"
                      AutomationProperties.Name="フォルダツリー"
                      VirtualizingPanel.IsVirtualizing="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectedItemChanged="OnTreeSelectedItemChanged">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="管理対象から外す" Click="OnRemoveFolderMenuClick" />
                    </ContextMenu>
                </TreeView.ContextMenu>
                <!-- テーマの見た目（選択の表示など）を引き継ぐ。BasedOn がないと、古い見た目に戻る -->
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
                        <Setter Property="ToolTip" Value="{Binding FullPath}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>

        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      AutomationProperties.Name="ナビゲーションの幅" />

        <!-- 中央: 検索・並べ替え・一覧 -->
        <DockPanel Grid.Column="2" Margin="12">
            <!-- 1行目: 一覧の絞り込みと見せ方（検索・並べ替え・表示の切替） -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="検索" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Width="240"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         ToolTip="ファイル名の一部を入力(空白で区切ると、すべてを含むものに絞り込みます)"
                         AutomationProperties.Name="ファイル名で検索" />
                <TextBlock Text="並べ替え" VerticalAlignment="Center" Margin="20,0,6,0" />
                <ComboBox Width="140"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption}"
                          DisplayMemberPath="Label"
                          AutomationProperties.Name="並べ替え項目" />
                <CheckBox Content="降順"
                          IsChecked="{Binding IsDescending}"
                          VerticalAlignment="Center"
                          MinWidth="0"
                          Margin="10,0,0,0"
                          AutomationProperties.Name="降順で並べ替え" />
                <TextBlock Text="表示" VerticalAlignment="Center" Margin="20,0,6,0" />
                <!-- テーマの既定の最小幅（120）では、選択肢の間が大きく空くため詰める -->
                <RadioButton Content="詳細"
                             GroupName="ViewMode"
                             IsChecked="{Binding IsDetailView}"
                             VerticalAlignment="Center"
                             MinWidth="0"
                             AutomationProperties.Name="詳細表示" />
                <RadioButton Content="サムネイル"
                             GroupName="ViewMode"
                             IsChecked="{Binding IsThumbnailView}"
                             VerticalAlignment="Center"
                             MinWidth="0"
                             Margin="14,0,0,0"
                             AutomationProperties.Name="サムネイル表示" />
            </WrapPanel>

            <!-- 2行目: 選択中のアーカイブへの操作（右クリックメニューと同じ）と、ライブラリ全体の再スキャン（右端） -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="スキャン中…"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="再スキャン"
                            Command="{Binding RescanCommand}"
                            Padding="12,3"
                            ToolTip="管理フォルダの中を調べ直して、追加・変更・削除を反映します"
                            AutomationProperties.Name="ライブラリを再スキャン" />
                </StackPanel>
            <WrapPanel DockPanel.Dock="Left" AutomationProperties.Name="選択中のアーカイブへの操作">
                <Button Content="開く"
                        Command="{Binding OpenSelectedCommand}"
                        Padding="12,3"
                        ToolTip="選択中のアーカイブを開きます (Enter)"
                        AutomationProperties.Name="選択中のアーカイブを開く" />
                <Button Content="名前変更"
                        Command="{Binding RenameSelectedCommand}"
                        Padding="12,3"
                        Margin="6,0,0,0"
                        ToolTip="名前を変更します (F2)"
                        AutomationProperties.Name="選択中のアーカイブの名前を変更" />
                <Button Content="移動…"
                        Command="{Binding MoveSelectedCommand}"
                        Padding="12,3"
                        Margin="6,0,0,0"
                        ToolTip="別のフォルダへ移動します"
                        AutomationProperties.Name="選択中のアーカイブを別のフォルダへ移動" />
                <Button Content="削除"
                        Command="{Binding DeleteSelectedCommand}"
                        Padding="12,3"
                        Margin="6,0,0,0"
                        ToolTip="ごみ箱へ移動します (Delete)"
                        AutomationProperties.Name="選択中のアーカイブを削除" />
                <Button Content="エクスプローラーで表示"
                        Command="{Binding ShowSelectedInExplorerCommand}"
                        Padding="12,3"
                        Margin="6,0,0,0"
                        AutomationProperties.Name="選択中のアーカイブをエクスプローラーで表示" />
            </WrapPanel>
            </DockPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding CountText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           AutomationProperties.Name="表示件数" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ThumbnailProgressText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           AutomationProperties.Name="サムネイル作成の進捗" />
            </DockPanel>

            <!--
                一覧の領域。ウィンドウの地（左のツリー・ツールバー）より一段明るい面にし、角を丸めた枠で囲んで、境をわかりやすくする。
                ウィンドウの地は半透明（Mica。壁紙の色がにじむ）のため、面は不透明な色にする。
                色はテーマの色（SolidBackgroundFillColor / SurfaceStrokeColor）を使う（ライトのテーマでも同じ関係になる）
            -->
            <Border x:Name="ListPanel"
                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
            <Grid>
                <!-- ListView / ListBoxはScrollViewerやStackPanelの中に置かない(置くと仮想化が無効になる) -->
                <ListView x:Name="DetailList"
                          ItemsSource="{Binding Archives}"
                          SelectedItem="{Binding SelectedArchive, Mode=TwoWay}"
                          SelectionMode="Single"
                          AutomationProperties.Name="アーカイブ一覧"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          MouseDoubleClick="OnArchiveListMouseDoubleClick"
                          KeyDown="OnArchiveListKeyDown"
                          SizeChanged="OnDetailListSizeChanged"
                          Background="Transparent"
                          BorderThickness="0"
                          Visibility="{Binding IsDetailView, Converter={StaticResource BoolToVisibility}}">
                    <!-- 行の高さは、テーマの見た目を引き継いだうえで画面側で詰める（ApplyCompactRows） -->
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="開く" Click="OnOpenMenuClick" />
                            <MenuItem Header="名前を変更 (F2)" Click="OnRenameMenuClick" />
                            <MenuItem Header="別のフォルダへ移動…" Click="OnMoveMenuClick" />
                            <MenuItem Header="削除 (Delete)" Click="OnDeleteMenuClick" />
                            <Separator />
                            <MenuItem Header="エクスプローラーで表示" Click="OnShowInExplorerMenuClick" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <!-- ファイル名の列の幅は、残りの幅に合わせて画面側で決める（横スクロールを出さないため。OnDetailListSizeChanged） -->
                        <GridView>
                            <GridViewColumn x:Name="FileNameColumn" Header="ファイル名" Width="320" CellTemplate="{StaticResource FileNameCell}" />
                            <GridViewColumn Header="保存場所" Width="220" CellTemplate="{StaticResource LocationCell}" />
                            <GridViewColumn Header="画像枚数" Width="80" DisplayMemberBinding="{Binding ImageCountText}" />
                            <GridViewColumn Header="ファイルサイズ" Width="110" DisplayMemberBinding="{Binding FileSizeText}" />
                            <GridViewColumn Header="更新日時" Width="150" DisplayMemberBinding="{Binding LastWriteTimeText}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <ListBox x:Name="ThumbnailList"
                         ItemsSource="{Binding ThumbnailRows}"
                         ItemTemplate="{StaticResource ThumbnailRowTemplate}"
                         AutomationProperties.Name="アーカイブのサムネイル一覧"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent"
                         BorderThickness="0"
                         Visibility="{Binding IsThumbnailView, Converter={StaticResource BoolToVisibility}}"
                         KeyDown="OnThumbnailListKeyDown"
                         SizeChanged="OnThumbnailListSizeChanged"
                         IsVisibleChanged="OnThumbnailListIsVisibleChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock Text="{Binding EmptyMessage}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmptyMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
