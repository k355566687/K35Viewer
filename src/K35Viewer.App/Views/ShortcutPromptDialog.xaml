<Window x:Class="K35Viewer.Views.ShortcutPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ショートカット"
        SizeToContent="Height"
        Width="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=StartMenuBox}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="35Viewer のショートカットを作りますか？"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="35Viewer にはインストーラーがないため、スタートメニューやデスクトップには、まだ入口がありません。作る場所を選んでください。あとから、設定画面でも作れます。" />

        <CheckBox x:Name="StartMenuBox"
                  Grid.Row="2"
                  Content="スタートメニューに作る"
                  IsChecked="True"
                  Checked="OnChoiceChanged"
                  Unchecked="OnChoiceChanged"
                  AutomationProperties.Name="スタートメニューにショートカットを作る" />
        <CheckBox x:Name="DesktopBox"
                  Grid.Row="3"
                  Margin="0,8,0,0"
                  Content="デスクトップに作る"
                  Checked="OnChoiceChanged"
                  Unchecked="OnChoiceChanged"
                  AutomationProperties.Name="デスクトップにショートカットを作る" />
        <TextBlock Grid.Row="4"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="タスクバーに置くときは、スタートメニューの「35Viewer」を右クリックして、「タスクバーにピン留めする」を選んでください。" />

        <StackPanel Grid.Row="5"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="OkButton"
                    Content="作る"
                    MinWidth="88"
                    Padding="12,5"
                    IsDefault="True"
                    Click="OnOkClick"
                    AutomationProperties.Name="選んだショートカットを作る" />
            <Button Content="今はしない"
                    MinWidth="88"
                    Padding="12,5"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    AutomationProperties.Name="ショートカットを作らない" />
        </StackPanel>
    </Grid>
</Window>
