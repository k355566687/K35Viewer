<Window x:Class="K35Viewer.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        MaxWidth="640"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!--
        確認・お知らせのダイアログ（Windows 標準のメッセージボックスの代わり）。テーマ（ダーク等）に追従する。
        ・確認: 「（操作）」と「キャンセル」。既定のボタン（Enter）と Esc は、どちらもキャンセル（誤って破壊的な操作にならないため）
        ・お知らせ: 「OK」だけ
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="確認の内容" />

        <TextBlock x:Name="DetailText"
                   Grid.Row="1"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   AutomationProperties.Name="補足" />

        <StackPanel Grid.Row="2"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="ConfirmButton"
                    MinWidth="96"
                    Padding="12,5"
                    Click="OnConfirmClick" />
            <Button x:Name="CancelButton"
                    MinWidth="96"
                    Padding="12,5"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
