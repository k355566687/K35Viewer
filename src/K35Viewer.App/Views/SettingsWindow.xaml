<Window x:Class="K35Viewer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 - 35Viewer"
        Width="760"
        Height="620"
        MinWidth="560"
        MinHeight="400"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!--
        設定画面（SCR-03。画面一覧 8.3）。変更は、その場で反映し、保存する（「OK / キャンセル」はない）。
        見出しで区切った項目を、上から順に並べる。Esc または「閉じる」で閉じる。
    -->
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style x:Key="ItemLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- 保存場所などの表示。選んでコピーできるよう、読み取り専用の入力欄にする -->
        <!-- テーマの見た目を引き継ぐ（BasedOn がないと、古い見た目（白い入力欄）に戻る） -->
        <Style x:Key="PathBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Button Content="閉じる"
                    HorizontalAlignment="Right"
                    MinWidth="96"
                    Padding="12,5"
                    IsCancel="True"
                    AutomationProperties.Name="設定を閉じる" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,4,24,20">
                <!-- 外観 -->
                <TextBlock Text="外観" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="テーマ" Style="{StaticResource ItemLabel}" />
                    <RadioButton Content="ダーク"
                                 GroupName="Theme"
                                 MinWidth="0"
                                 IsChecked="{Binding IsDarkTheme}"
                                 AutomationProperties.Name="テーマ: ダーク" />
                    <RadioButton Content="ライト"
                                 GroupName="Theme"
                                 MinWidth="0"
                                 Margin="16,0,0,0"
                                 IsChecked="{Binding IsLightTheme}"
                                 AutomationProperties.Name="テーマ: ライト" />
                    <RadioButton Content="Windowsの設定に合わせる"
                                 GroupName="Theme"
                                 MinWidth="0"
                                 Margin="16,0,0,0"
                                 IsChecked="{Binding IsSystemTheme}"
                                 AutomationProperties.Name="テーマ: Windowsの設定に合わせる" />
                </StackPanel>

                <!-- 確認 -->
                <TextBlock Text="確認" Style="{StaticResource SectionHeader}" />
                <CheckBox Content="アーカイブから離れるとき、削除予約を反映するか確認する"
                          IsChecked="{Binding ConfirmBeforeLeave}"
                          AutomationProperties.Name="アーカイブから離れるときの確認" />
                <TextBlock Style="{StaticResource Note}"
                           Text="オフにすると、確認せずにアーカイブを更新します。更新できないときは確認します。" />
                <CheckBox Content="アーカイブを削除するとき、確認する"
                          Margin="0,12,0,0"
                          IsChecked="{Binding ConfirmBeforeDelete}"
                          AutomationProperties.Name="アーカイブを削除するときの確認" />
                <TextBlock Style="{StaticResource Note}"
                           Text="ごみ箱を使えない場所での完全な削除は、常に確認します。" />
                <!-- データ -->
                <TextBlock Text="データ" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="保存場所" Style="{StaticResource ItemLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding DataFolder, Mode=OneWay}"
                             Style="{StaticResource PathBox}"
                             AutomationProperties.Name="アプリのデータの保存場所" />
                    <Button Grid.Row="0" Grid.Column="2"
                            Content="フォルダを開く"
                            Padding="12,4"
                            Command="{Binding OpenDataFolderCommand}"
                            AutomationProperties.Name="アプリのデータの保存場所を開く" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="サムネイルのキャッシュ" Style="{StaticResource ItemLabel}" Margin="0,8,12,0" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Margin="0,8,8,0"
                             Text="{Binding ThumbnailsFolder, Mode=OneWay}"
                             Style="{StaticResource PathBox}"
                             AutomationProperties.Name="サムネイルのキャッシュの保存場所" />
                    <Button Grid.Row="1" Grid.Column="2"
                            Margin="0,8,0,0"
                            Content="フォルダを開く"
                            Padding="12,4"
                            Command="{Binding OpenThumbnailsFolderCommand}"
                            AutomationProperties.Name="サムネイルのキャッシュの保存場所を開く" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="キャッシュの大きさ" Style="{StaticResource ItemLabel}" Margin="0,8,12,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Margin="0,8,8,0"
                               VerticalAlignment="Center"
                               Text="{Binding CacheSizeText}"
                               AutomationProperties.Name="サムネイルのキャッシュの大きさ" />
                    <Button Grid.Row="2" Grid.Column="2"
                            Margin="0,8,0,0"
                            Content="キャッシュを削除"
                            Padding="12,4"
                            Command="{Binding ClearThumbnailCacheCommand}"
                            ToolTip="{Binding ClearCacheToolTip}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="サムネイルのキャッシュを削除" />
                </Grid>
                <TextBlock Style="{StaticResource Note}"
                           Text="ライブラリの情報（DB）、設定、ログは「保存場所」に、サムネイルは「サムネイルのキャッシュ」に保存しています。" />

                <!-- 情報 -->
                <TextBlock Text="情報" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding VersionText}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               AutomationProperties.Name="アプリの版" />
                    <Button Content="MIT License"
                            Padding="12,4"
                            Command="{Binding OpenLicenseCommand}"
                            ToolTip="ライセンスのページ（GitHub）をブラウザで開きます"
                            AutomationProperties.Name="ライセンスのページを開く" />
                    <Button Content="GitHub のページ"
                            Padding="12,4"
                            Margin="8,0,0,0"
                            Command="{Binding OpenRepositoryCommand}"
                            ToolTip="35Viewer のリポジトリ（GitHub）をブラウザで開きます"
                            AutomationProperties.Name="GitHub のページを開く" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
