<Window x:Class="K35Viewer.Views.UninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アンインストール"
        SizeToContent="Height"
        Width="640"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!--
        アンインストールの確認（画面一覧 DLG-05。GitHub の Issue #24）。何を消し、何を消さないかを示し、バックアップの保存先を選んでもらい、
        「アンインストール」と入力してもらう。既定のボタンと Esc は、キャンセル。
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="35Viewer をアンインストールしますか？"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="次のものを削除します。元に戻せません（ごみ箱へは送りません）。" />

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock x:Name="ProgramText" TextWrapping="Wrap" AutomationProperties.Name="削除するプログラムのフォルダ" />
                <TextBlock x:Name="DataText" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.Name="削除するデータのフォルダ" />
                <TextBlock x:Name="ShortcutText" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.Name="削除するショートカット" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold"
                   Text="アーカイブ（管理フォルダの中のファイル）には、さわりません。" />

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <CheckBox x:Name="BackupBox"
                      Content="削除の前に、データのバックアップを保存する"
                      IsChecked="True"
                      Checked="OnChanged"
                      Unchecked="OnChanged"
                      AutomationProperties.Name="削除の前に、データのバックアップを保存する" />
            <Grid x:Name="BackupPanel" Margin="24,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox"
                         Grid.Column="0"
                         VerticalContentAlignment="Center"
                         TextChanged="OnTextChanged"
                         AutomationProperties.Name="バックアップの保存先" />
                <Button Grid.Column="1"
                        Content="選ぶ…"
                        Margin="8,0,0,0"
                        Padding="12,4"
                        Click="OnBrowseClick"
                        AutomationProperties.Name="バックアップの保存先を選ぶ" />
            </Grid>
            <TextBlock x:Name="FolderError"
                       Margin="24,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="バックアップの保存先の問題" />
            <TextBlock Margin="24,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="今のデータのバックアップを、1つ保存します。いまある自動バックアップ（データのフォルダの backups）は、削除します。あとで、35Viewer を入れ直したら、設定の「復元…」で、戻せます。" />
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,14,0,0">
            <TextBlock TextWrapping="Wrap" Text="確認のため、「アンインストール」と入力してください。" />
            <TextBox x:Name="ConfirmBox"
                     Margin="0,6,0,0"
                     VerticalContentAlignment="Center"
                     TextChanged="OnTextChanged"
                     AutomationProperties.Name="確認の入力" />
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="OkButton"
                    Content="アンインストール"
                    MinWidth="120"
                    Padding="12,5"
                    IsEnabled="False"
                    Click="OnOkClick"
                    AutomationProperties.Name="アンインストールする" />
            <Button Content="キャンセル"
                    MinWidth="88"
                    Padding="12,5"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    IsCancel="True"
                    AutomationProperties.Name="キャンセル" />
        </StackPanel>
    </Grid>
</Window>
