<Window x:Class="K35Viewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:K35Viewer.Views"
        Title="{Binding Title}"
        Width="1280"
        Height="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid>
        <!-- どちらの画面も作り直さず、表示を切り替える（ライブラリへ戻ったときに状態が残る） -->
        <Grid Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolToVisibility}}">
            <views:LibraryView DataContext="{Binding Library}" />
        </Grid>
        <Grid Visibility="{Binding IsViewerVisible, Converter={StaticResource BoolToVisibility}}">
            <views:ViewerView DataContext="{Binding Viewer}" />
        </Grid>
        <!-- アーカイブの更新中。画面の操作を受け付けないよう、全体を覆う -->
        <Border Background="#CC000000"
                Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}"
                Focusable="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                <TextBlock Text="アーカイブを更新しています"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           AutomationProperties.Name="更新中" />
                <TextBlock Text="{Binding UpdateStatusText}"
                           Foreground="#DDDDDD"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="更新の進行状況" />
                <ProgressBar IsIndeterminate="True"
                             Height="8"
                             Margin="0,14,0,0"
                             AutomationProperties.Name="更新の進行" />
                <Button Content="キャンセル (Esc)"
                        Command="{Binding CancelUpdateCommand}"
                        HorizontalAlignment="Right"
                        Padding="14,5"
                        Margin="0,16,0,0"
                        AutomationProperties.Name="更新をキャンセル" />
            </StackPanel>
        </Border>
        <views:ToastHost DataContext="{Binding Toasts}"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="16,16,16,56" />
    </Grid>
</Window>
