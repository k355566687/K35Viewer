<Window x:Class="K35Viewer.Views.ArchiveChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アーカイブの変更確認"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        MaxWidth="640"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="変更の内容" />

        <TextBlock x:Name="NoteText"
                   Grid.Row="1"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <StackPanel Grid.Row="2"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="UpdateButton"
                    Content="更新する"
                    MinWidth="96"
                    Padding="12,5"
                    Click="OnUpdateClick"
                    AutomationProperties.Name="アーカイブを更新する" />
            <Button x:Name="DiscardButton"
                    Content="変更を破棄"
                    MinWidth="96"
                    Padding="12,5"
                    Margin="8,0,0,0"
                    Click="OnDiscardClick"
                    AutomationProperties.Name="変更を破棄して離れる" />
            <Button x:Name="CancelButton"
                    Content="キャンセル"
                    MinWidth="96"
                    Padding="12,5"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    IsCancel="True"
                    AutomationProperties.Name="離れるのをやめる" />
        </StackPanel>
    </Grid>
</Window>
