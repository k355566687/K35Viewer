<Window x:Class="K35Viewer.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="35Viewer のアンインストール"
        Width="560"
        SizeToContent="Height"
        MaxHeight="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True">
    <!--
        アンインストールの間と、結果を出すウィンドウ（GitHub の Issue #24。内部アーキテクチャ設計書 44章）。
        消す処理を行う「控え」のプロセスが出す。消している間は、閉じられない。終わると、結果を出し、「閉じる」を押せる。
    -->
    <Border BorderThickness="1"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            Padding="28,24">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Text="35Viewer をアンインストールしています"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="アンインストールの表示" />
            <TextBlock x:Name="StatusText"
                       Text="しばらくお待ちください。"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="今していること" />
            <ProgressBar x:Name="Bar"
                         IsIndeterminate="True"
                         Height="6"
                         Margin="0,16,0,0"
                         AutomationProperties.Name="アンインストールの進み具合の棒" />
            <TextBox x:Name="DetailBox"
                     Visibility="Collapsed"
                     Margin="0,14,0,0"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MaxHeight="260"
                     AutomationProperties.Name="結果の詳細" />
            <Button x:Name="CloseButton"
                    Visibility="Collapsed"
                    Content="閉じる"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    MinWidth="96"
                    Padding="12,5"
                    IsDefault="True"
                    Click="OnCloseClick"
                    AutomationProperties.Name="閉じる" />
        </StackPanel>
    </Border>
</Window>
