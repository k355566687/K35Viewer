<UserControl x:Class="K35Viewer.Views.ViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Fluent テーマの見た目を引き継ぐ（BasedOn がないと、古い見た目に戻る） -->
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <!-- 一覧表示の1枚。選択は背景色と「✓」、現在位置は白い枠で示す（色だけに頼らない） -->
        <DataTemplate x:Key="PageCell">
            <Border Width="164"
                    Margin="6"
                    Padding="3"
                    BorderThickness="2"
                    CornerRadius="3"
                    ToolTip="{Binding EntryName}"
                    AutomationProperties.Name="{Binding DisplayName}"
                    AutomationProperties.ItemStatus="{Binding StatusText}"
                    MouseLeftButtonDown="OnPageCellMouseLeftButtonDown"
                    MouseRightButtonDown="OnPageCellMouseRightButtonDown">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="削除予約" Click="OnReserveDeleteClick" />
                        <MenuItem Header="削除予約を解除" Click="OnReleaseDeleteClick" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#2F5D9E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="BorderBrush" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Height="212" Background="#2E2E2E">
                        <TextBlock Text="{Binding PlaceholderText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="#BBBBBB" />
                        <Image Source="{Binding Thumbnail}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPendingDelete}" Value="True">
                                            <Setter Property="Opacity" Value="0.3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <!-- 削除予約された画像。薄く表示するだけでなく、文字でも示す（色だけに頼らない） -->
                        <TextBlock Text="削除予定"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Padding="8,3"
                                   Foreground="White"
                                   Background="{DynamicResource K35.DangerFillBrush}"
                                   FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPendingDelete}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="✓"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="4"
                                   Padding="5,1"
                                   Foreground="White"
                                   Background="#2F5D9E"
                                   FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding PageNumberText}" Foreground="#BBBBBB" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
            一覧表示の1行分。選択やフォーカスの枠は付けない。
            エクスプローラーと同じく、カードの大きさは変えずに、余った幅をカードの間へ均等に分ける（ライブラリ画面と同じ）。
        -->
        <DataTemplate x:Key="PageRowTemplate">
            <ItemsControl ItemsSource="{Binding Items}"
                          ItemTemplate="{StaticResource PageCell}"
                          Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"
                                     Columns="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ツールバー（全画面では隠す）。テーマに合わせる。暗いままにするのは、下の画像の領域だけ（画面一覧 12.1） -->
        <Border Grid.Row="0"
                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6"
                Visibility="{Binding ShowToolbar, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="← ライブラリへ戻る"
                        Command="{Binding RequestCloseCommand}"
                        Padding="12,4"
                        ToolTip="ライブラリへ戻る (Esc)"
                        AutomationProperties.Name="ライブラリへ戻る" />
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding ArchiveName}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
                <Button DockPanel.Dock="Right"
                        Content="全画面"
                        Command="{Binding ToggleFullScreenCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="全画面表示の切り替え (F11)"
                        AutomationProperties.Name="全画面表示の切り替え" />
                <Button DockPanel.Dock="Right"
                        Content="{Binding ViewModeToggleText}"
                        Command="{Binding ToggleViewModeCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="1枚表示と一覧表示の切り替え (G)"
                        AutomationProperties.Name="表示方式の切り替え" />
                <!-- RAR / 7z は閲覧だけ。編集したいときは ZIP に変換する（GitHub の Issue #20） -->
                <Button DockPanel.Dock="Right"
                        Content="ZIP に変換"
                        Command="{Binding RequestConvertToZipCommand}"
                        Style="{StaticResource ToolbarButton}"
                        Visibility="{Binding IsReadOnlyArchive, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="このアーカイブ（RAR / 7z）を ZIP に変換します。変換すると、画像を削除できるようになり、ソリッド形式でも速く表示できます"
                        AutomationProperties.Name="ZIP に変換" />
                <!-- 拡大・縮小は1枚表示のときだけ -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Margin="0,0,16,0"
                            Visibility="{Binding IsSingleView, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="－"
                            Command="{Binding ZoomOutCommand}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="縮小 (− / Ctrl+ホイール)"
                            AutomationProperties.Name="縮小" />
                    <TextBlock Text="{Binding ZoomText}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"
                               MinWidth="110"
                               TextAlignment="Center"
                               AutomationProperties.Name="拡大率" />
                    <Button Content="＋"
                            Command="{Binding ZoomInCommand}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="拡大 (+ / Ctrl+ホイール)"
                            AutomationProperties.Name="拡大" />
                    <Button Content="フィット"
                            Command="{Binding FitCommand}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="ウィンドウに合わせる (0)"
                            AutomationProperties.Name="ウィンドウに合わせる" />
                    <Button Content="原寸"
                            Command="{Binding ActualSizeCommand}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="原寸で表示 (1)"
                            AutomationProperties.Name="原寸で表示" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 表示領域: 1枚表示 / 一覧表示（どちらか一方だけを表示する） -->
        <Grid Grid.Row="1">
            <!-- 1枚表示 -->
            <Grid Visibility="{Binding IsSingleView, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer x:Name="PageScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Focusable="False"
                              AutomationProperties.Name="画像の表示領域"
                              PreviewMouseWheel="OnPreviewMouseWheel"
                              PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
                              PreviewMouseMove="OnPreviewMouseMove"
                              PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
                              SizeChanged="OnPageScrollSizeChanged"
                              ScrollChanged="OnPageScrollChanged">
                    <Grid x:Name="PageHost">
                        <Image Source="{Binding CurrentImage}"
                               Width="{Binding DisplayWidth}"
                               Height="{Binding DisplayHeight}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="{Binding EntryName}">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentPendingDelete}" Value="True">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Grid>
                </ScrollViewer>

                <!-- 一覧から、削除予約済みの画像を1枚表示した場合（Deleteで解除できる） -->
                <TextBlock Text="削除予定（Deleteで解除）"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,16,0,0"
                           Padding="12,4"
                           Foreground="White"
                           Background="{DynamicResource K35.DangerFillBrush}"
                           FontWeight="Bold"
                           IsHitTestVisible="False"
                           AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentPendingDelete}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="読み込み中…"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#DDDDDD"
                           FontSize="16"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="{Binding ErrorText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#FFB4B4"
                           FontSize="16"
                           TextWrapping="Wrap"
                           MaxWidth="600"
                           IsHitTestVisible="False"
                           AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- 一覧表示（ListBoxはScrollViewerやStackPanelの中に置かない。置くと仮想化が無効になる） -->
            <ListBox x:Name="PageList"
                     ItemsSource="{Binding PageRows}"
                     ItemTemplate="{StaticResource PageRowTemplate}"
                     Background="#1E1E1E"
                     BorderThickness="0"
                     AutomationProperties.Name="アーカイブ内の画像の一覧"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}"
                     SizeChanged="OnPageListSizeChanged"
                     IsVisibleChanged="OnPageListIsVisibleChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- 現在位置（全画面でも常に表示する）。一覧表示では選択数も -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="12"
                    Padding="10,4"
                    Background="#CC000000"
                    CornerRadius="4"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PositionText}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               AutomationProperties.Name="現在位置" />
                    <TextBlock Text="{Binding ZoomText}"
                               Foreground="#CCCCCC"
                               Margin="14,0,0,0"
                               Visibility="{Binding IsSingleView, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding PendingDeleteText}"
                               Foreground="#FFB4AB"
                               FontWeight="SemiBold"
                               Margin="14,0,0,0"
                               AutomationProperties.Name="削除予定件数"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding SelectionText}"
                               Foreground="#9CC2FF"
                               FontWeight="SemiBold"
                               Margin="14,0,0,0"
                               Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.Name="選択数" />
                </StackPanel>
            </Border>

            <!-- 全画面のときだけ、アーカイブ名を表示する -->
            <TextBlock Text="{Binding ArchiveName}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="12"
                       Foreground="#CCCCCC"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
