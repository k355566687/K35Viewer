<UserControl x:Class="K35Viewer.Views.ViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ツールバー（全画面では隠す） -->
        <Border Grid.Row="0"
                Background="#2B2B2B"
                Padding="8,6"
                Visibility="{Binding ShowToolbar, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="← ライブラリへ戻る"
                        Command="{Binding RequestCloseCommand}"
                        Padding="12,4"
                        ToolTip="ライブラリへ戻る (Esc)"
                        AutomationProperties.Name="ライブラリへ戻る" />
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding ArchiveName}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
                <Button DockPanel.Dock="Right"
                        Content="全画面"
                        Command="{Binding ToggleFullScreenCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="全画面表示の切り替え (F11)"
                        AutomationProperties.Name="全画面表示の切り替え" />
                <Button DockPanel.Dock="Right"
                        Content="原寸"
                        Command="{Binding ActualSizeCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="原寸で表示 (1)"
                        AutomationProperties.Name="原寸で表示" />
                <Button DockPanel.Dock="Right"
                        Content="フィット"
                        Command="{Binding FitCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="ウィンドウに合わせる (0)"
                        AutomationProperties.Name="ウィンドウに合わせる" />
                <Button DockPanel.Dock="Right"
                        Content="＋"
                        Command="{Binding ZoomInCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="拡大 (+ / Ctrl+ホイール)"
                        AutomationProperties.Name="拡大" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ZoomText}"
                           Foreground="White"
                           VerticalAlignment="Center"
                           MinWidth="110"
                           TextAlignment="Center"
                           AutomationProperties.Name="拡大率" />
                <Button DockPanel.Dock="Right"
                        Content="－"
                        Command="{Binding ZoomOutCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="縮小 (− / Ctrl+ホイール)"
                        AutomationProperties.Name="縮小" />
            </DockPanel>
        </Border>

        <!-- 画像の表示領域 -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="PageScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Focusable="False"
                          AutomationProperties.Name="画像の表示領域"
                          PreviewMouseWheel="OnPreviewMouseWheel"
                          PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
                          PreviewMouseMove="OnPreviewMouseMove"
                          PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
                          SizeChanged="OnPageScrollSizeChanged"
                          ScrollChanged="OnPageScrollChanged">
                <Grid x:Name="PageHost">
                    <Image Source="{Binding CurrentImage}"
                           Width="{Binding DisplayWidth}"
                           Height="{Binding DisplayHeight}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="{Binding EntryName}" />
                </Grid>
            </ScrollViewer>

            <TextBlock Text="読み込み中…"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#DDDDDD"
                       FontSize="16"
                       IsHitTestVisible="False"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding ErrorText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#FFB4B4"
                       FontSize="16"
                       TextWrapping="Wrap"
                       MaxWidth="600"
                       IsHitTestVisible="False"
                       AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 現在位置（全画面でも常に表示する） -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="12"
                    Padding="10,4"
                    Background="#CC000000"
                    CornerRadius="4"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PositionText}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               AutomationProperties.Name="現在位置" />
                    <TextBlock Text="{Binding ZoomText}"
                               Foreground="#CCCCCC"
                               Margin="14,0,0,0" />
                </StackPanel>
            </Border>

            <!-- 全画面のときだけ、アーカイブ名を表示する -->
            <TextBlock Text="{Binding ArchiveName}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="12"
                       Foreground="#CCCCCC"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
