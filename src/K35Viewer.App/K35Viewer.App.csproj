<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>K35Viewer</RootNamespace>
    <AssemblyName>K35Viewer</AssemblyName>
    <!-- WPF の Fluent テーマ（ThemeMode）は、.NET 10 では試験的な API（WPF0001）。採用を判断したうえで警告を抑止する
         （開発環境設計書 5章。将来の .NET で変更があった場合は、ここと App.xaml を見直す） -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- P/Invoke（LibraryImport）の生成コードに必要 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 実行ファイルのプロパティに表示する情報。Version は、リリースのタグ（v0.1.0 など）と合わせる -->
    <Version>0.2.2</Version>
    <Product>35Viewer</Product>
    <Company>k355566687</Company>
    <Copyright>Copyright (c) 2026 k355566687</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- GeneratePathProperty: 配布物に、このパッケージの第三者の告知を写すため（下の AddThirdPartyNoticeFiles） -->
    <PackageReference Include="CommunityToolkit.Mvvm" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF SDKの暗黙usingにはSystem.IOが含まれないため追加する -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- DBマイグレーション。リソース名は「Migrations.NNNN_名前.sql」に固定する -->
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="K35Viewer.Tests" />
  </ItemGroup>
  <!--
    ライセンスの表示（GitHub の Issue #22）。配布物（publish）の直下に、アプリのライセンスと、第三者の部品の告知を置く。
    THIRD-PARTY-NOTICES.txt は手で書く（同梱する部品が、すべて載っていることは、テストで確かめる）。
    licenses の中は、ビルドに使ったパッケージから写す（版が変わっても、その版の告知になる）。
  -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="AddThirdPartyNoticeFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_K35RuntimeNotice Include="@(ResolvedRuntimePack->'%(PackageDirectory)\THIRD-PARTY-NOTICES.TXT')"
                         Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <_K35ToolkitNotice Include="$(PkgCommunityToolkit_Mvvm)\ThirdPartyNotices.txt" />
    </ItemGroup>
    <Error Condition="'@(_K35RuntimeNotice)' == '' or !Exists('@(_K35RuntimeNotice)')"
           Text=".NET ランタイムの第三者の告知（THIRD-PARTY-NOTICES.TXT）が見つかりません。配布物に告知を入れられないため、中止します。" />
    <Error Condition="!Exists('@(_K35ToolkitNotice)')"
           Text="CommunityToolkit.Mvvm の第三者の告知（ThirdPartyNotices.txt）が見つかりません: @(_K35ToolkitNotice)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_K35RuntimeNotice)" RelativePath="licenses\dotnet-runtime-THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(_K35ToolkitNotice)" RelativePath="licenses\CommunityToolkit.Mvvm-ThirdPartyNotices.txt" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
