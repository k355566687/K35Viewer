<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>K35Viewer</RootNamespace>
    <AssemblyName>K35Viewer</AssemblyName>
    <!-- WPF の Fluent テーマ（ThemeMode）は、.NET 10 では試験的な API（WPF0001）。採用を判断したうえで警告を抑止する
         （開発環境設計書 5章。将来の .NET で変更があった場合は、ここと App.xaml を見直す） -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- P/Invoke（LibraryImport）の生成コードに必要 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF SDKの暗黙usingにはSystem.IOが含まれないため追加する -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- DBマイグレーション。リソース名は「Migrations.NNNN_名前.sql」に固定する -->
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="K35Viewer.Tests" />
  </ItemGroup>

</Project>
